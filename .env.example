# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Para regenerar tipos con `npm run db:types` (requiere `supabase login` + link):
# SUPABASE_PROJECT_ID=xxxxxxxxxxxx

# ─── IA — proveedor del agente ───────────────────────────────────────────────
# El motor de IA está detrás de lib/ai/provider.ts (resolveModel). El modelo por
# tenant se guarda en ai_config.model con formato `proveedor:modelo`
# (sin prefijo = anthropic). Cambiar de proveedor NO toca código de negocio.
#
# Anthropic / Claude (activo por defecto) — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
#
# Ollama (alternativa self-hosted para cuando escale; ver plan.md → Portabilidad).
# Se activa registrando el provider en lib/ai/provider.ts. No requiere API key,
# solo la URL del servidor Ollama:
# OLLAMA_BASE_URL=http://localhost:11434/api

# ─── n8n (automatizaciones) ──────────────────────────────────────────────────
# Sin esta base, los eventos NO se disparan (y no pasa nada: el lead ya está
# guardado en la DB antes de avisar). Ver lib/n8n.ts.
N8N_WEBHOOK_BASE_URL=https://n8n.tudominio.com/webhook
# Firma HMAC-SHA256 del cuerpo, en la cabecera `x-signature`, para que n8n
# compruebe que el evento viene de nosotros. Sin secreto no se manda cabecera:
# una firma con secreto vacío la reproduce cualquiera y solo daría falsa
# sensación de autenticación. Cadena larga y aleatoria.
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio

# ─── Resend (emails transaccionales) ────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...

# ─── App ────────────────────────────────────────────────────────────────────
# En local: http://localhost:3000  |  En prod: https://tuagencia.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Integraciones por feature (activar cuando se llegue a su fase) ──────────
# Google Places — bloque Testimonials con reseñas de Google (Fase 4, Paso 3).
# La llamada ocurre en servidor; el Place ID por tenant va en config.integrations.
# GOOGLE_PLACES_API_KEY=AIza...
#
# Cal.com — motor de reservas tier_2 (Fase 7).
# CALCOM_API_KEY=cal_...
#
# 360dialog — WhatsApp Business API tier_3 (Fase 8).
# WHATSAPP_360DIALOG_API_KEY=...
# WHATSAPP_360DIALOG_PHONE_ID=...
